# ============================================================================
# SHEGO — variables d'environnement (Technical Blueprint V1.3 §25-§26)
# Copier vers `.env.local` (développement, ignoré par git). Staging/production : variables EAS
# (`eas env:create`) — un projet Supabase distinct par environnement. NE JAMAIS committer de valeur réelle.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. APP MOBILE — variables `EXPO_PUBLIC_*` : INCLUSES dans le bundle, donc publiques par construction.
#    Uniquement des identifiants non secrets. Jamais de clé service ni de secret Apple/Google ici.
# ---------------------------------------------------------------------------
# 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Identifiants client Google (publics) pour le SDK natif Sign in with Google.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
# Schéma d'URL iOS inversé du client Google iOS (plugin natif, lu par app.config.ts au build).
GOOGLE_IOS_URL_SCHEME=

# ---------------------------------------------------------------------------
# 2. SERVEUR — JAMAIS dans l'app. À définir dans Supabase (Auth providers, secrets des Edge Functions)
#    et dans l'environnement du CLI Supabase (`supabase/config.toml` lit `env(...)`).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=            # Edge Functions uniquement
# Sign in with Apple — configuré côté Supabase Auth
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_IDS=                     # "<Services ID>,<bundle id iOS>" — voir supabase/config.toml
APPLE_CLIENT_SECRET=                  # JWT ES256 dérivé des 4 valeurs ci-dessus ; renouvellement tous les 6 mois
# Sign in with Google — configuré côté Supabase Auth
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=                 # requis par Supabase Auth pour valider l'id_token Google
GOOGLE_CLIENT_SECRET=
# Résolution automatique de lieu (OPTIONNELLE, Blueprint §9) — serveur uniquement
PLACES_API_KEY=

# ---------------------------------------------------------------------------
# 3. OUTILLAGE (CLI / CI) — pas de secret applicatif
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID=                  # pour `npm run db:types:remote`
